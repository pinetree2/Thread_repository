# Naver Search News API (recommended for Korean news coverage)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional global trend signals
SERPAPI_API_KEY=
# Optional: raises GitHub REST API rate limits for public repository search.
GITHUB_TOKEN=

# Optional LLM provider. Without this key, a deterministic grounded writer is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai

# Runtime
REQUEST_TIMEOUT_SECONDS=15
FACT_CHECK_THRESHOLD=0.80
MAX_RESEARCH_RETRY=2
MAX_HN_ITEMS=60
MAX_YOUTUBE_VIDEO_DETAILS=3
MAX_CONTENT_RETRY=2

# Meta Threads API: 실제 게시에는 Threads user access token이 필요합니다.
# THREADS_USER_ID는 참고용이며 게시 요청은 토큰 소유자를 뜻하는 /me를 사용합니다.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# 비워두면 Meta 앱에 설정된 기본 Graph API 버전을 사용합니다.
THREADS_GRAPH_API_VERSION=
LOG_LEVEL=INFO

# Cloudflare Cron -> Railway scheduled endpoint authentication
CRON_SECRET=
# Railway Volume을 /data에 mount한 경우 /data로 설정합니다.
DATA_DIR=.data
